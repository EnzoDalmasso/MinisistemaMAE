# Variables de entorno para ejecutar el backend fuera de desarrollo local
# (Docker, Render, etc). En desarrollo local alcanza con
# Clinica.API/appsettings.Development.json, que ya trae valores de ejemplo.
#
# ASP.NET Core mapea automáticamente variables de entorno a su configuración
# usando "__" (doble guion bajo) como separador de sección — por eso las claves
# no son planas como en otros stacks. Se indica entre paréntesis el nombre
# equivalente sugerido en la consigna original.

# Cadena de conexión a PostgreSQL (equivale a CONEXION_BASE_DATOS).
ConnectionStrings__BaseDeDatos=Host=<host>;Port=5432;Database=clinica;Username=<usuario>;Password=<clave>

# Clave de firma de los tokens JWT (equivale a CLAVE_JWT). Usar un valor largo,
# aleatorio y distinto al de desarrollo. Nunca reutilizar el valor de ejemplo.
Jwt__Clave=<clave-secreta-larga-y-aleatoria>
Jwt__Emisor=ClinicaAPI
Jwt__Audiencia=ClinicaFrontend
Jwt__ExpiracionMinutos=120

# Origen exacto del frontend desplegado, sin barra final (habilita CORS solo para ese origen).
ORIGEN_FRONTEND=https://<tu-frontend>.vercel.app

# Contraseñas de los usuarios de demostración que carga el seed al iniciar.
# Opcionales: si no se definen, se usan valores de desarrollo (ver README).
DatosSemilla__ContrasenaAdministrador=<contrasena-demo-admin>
DatosSemilla__ContrasenaProfesional=<contrasena-demo-profesional>

ASPNETCORE_ENVIRONMENT=Production
